# Copy to e2e/.env and fill in real values. See e2e/README.md.

# --- Where the two apps are running ---
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8765/api

# --- Same Supabase project /web is configured against (copy from web/.env) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- Auth strategy (see e2e/README.md#auth-strategy) ---
# Preferred: set this (Project settings -> API -> service_role secret key)
# and global-setup creates two brand-new, pre-confirmed throwaway test
# users on every run via Supabase's Admin API. NEVER commit this value,
# and never ship it to the browser/frontend — /web only ever uses the
# publishable key above.
#SUPABASE_SERVICE_ROLE_KEY=

# Fallback: used only when SUPABASE_SERVICE_ROLE_KEY is unset. Must be two
# *already confirmed* Supabase accounts (email/password) — global-setup
# does not attempt to sign them up.
#E2E_OWNER_EMAIL=
#E2E_OWNER_PASSWORD=
#E2E_MEMBER_EMAIL=
#E2E_MEMBER_PASSWORD=
