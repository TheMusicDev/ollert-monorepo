# Copy to .env.fe (or /web/.env once /web is scaffolded — see planning/architecture.md)
# and fill in real values. Everything TanStack Start's /web needs; see fe-tasks.md.
# VITE_ prefix required — Vite (which TanStack Start builds on) only exposes
# prefixed vars to client code via import.meta.env.

# Project settings -> API -> Project URL / publishable key (sb_publishable_...).
# Replaces the legacy "anon key" naming — Supabase deprecates anon/service_role
# keys end of 2026: https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the CakePHP API (see be-tasks.md).
VITE_API_BASE_URL=http://localhost:8765/api
