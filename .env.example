# Copy to .env and fill in real values. This file documents every env var
# the app needs across all three pieces (docker services, /api, /web) in one
# place since /api and /web aren't scaffolded yet — split into per-package
# .env files when those exist. See planning/architecture.md.

# --- Local dev services (docker/, MariaDB + Mailpit) ---
# Mirrors docker/.env.example — keep these in sync, /api connects to this DB.
DB_HOST=127.0.0.1
DB_PORT=9937
DB_DATABASE=ollert
DB_USERNAME=ollert
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- /api (CakePHP) ---
APP_ENV=development
APP_DEBUG=true
APP_DEFAULT_LOCALE=en_US
APP_DEFAULT_TIMEZONE=UTC
# CakePHP's Security.salt — generate a random 40+ char string, unique per environment.
SECURITY_SALT=

# Supabase JWT verification (see planning/architecture.md#auth-flow).
# Project settings -> API -> JWT Keys once the Supabase project exists.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
JWKS_CACHE_TTL=900

# Comma-separated origin allow-list (see planning/architecture.md#cors).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- /web (TanStack Start) ---
# Project settings -> API -> Project URL / publishable key (sb_publishable_...).
# Replaces the legacy "anon key" naming — Supabase deprecates anon/service_role
# keys end of 2026: https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8765/api
