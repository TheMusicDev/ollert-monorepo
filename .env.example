# Aggregate of every .env.example in this repo (api/, web/, mcp/, e2e/,
# .kamal/secrets) — one file to fill out instead of five.
#
# Setup:
#   A) cp .env.example .env
#   B) fill in the values below (local-dev defaults are already correct —
#      you mainly just need API__SECURITY_SALT)
#   C) bun run env   (runs scripts/sync-env.sh, writes api/.env, web/.env,
#      mcp/.env, e2e/.env, .kamal/secrets from this file)
#
# Prefix convention: `<TARGET>__<VAR>` — sync-env.sh strips the prefix and
# writes `VAR=value` into the matching file. A prefix with no matching
# lines just means that target file gets a near-empty file; comment out
# whole sections you don't need (e.g. KAMAL__* if you're not deploying).
#
# sync-env.sh SKIPS a target file that already exists — pass -f/--force to
# `bun run env` to overwrite. Re-running after editing this file is safe by
# default; you won't clobber hand-edited target files by accident.

# ============================================================
# API  →  api/.env   (CakePHP backend, local dev)
# ============================================================
API__APP_NAME=Ollert
API__DEBUG=true
API__APP_ENCODING=UTF-8
API__APP_DEFAULT_LOCALE=en_US
API__APP_DEFAULT_TIMEZONE=UTC
# SECURITY: required in production to prevent Host Header Injection attacks. Empty is fine locally.
API__APP_FULL_BASE_URL=
# Random 40+ char string, unique per environment: php -r 'echo bin2hex(random_bytes(40));'
API__SECURITY_SALT=

# DB — Supabase CLI local stack (`supabase start` from the repo root).
API__DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Used only by the PHPUnit test suite; defaults to a throwaway sqlite file if unset.
#API__DATABASE_TEST_URL=sqlite://127.0.0.1/tmp/tests.sqlite

# Supabase JWT verification — local stack, RS256 via supabase/signing_keys.json
# (see CLAUDE.md Learnings 2026-08-27/29). Prod would use the hosted project's
# https://<project-ref>.supabase.co/auth/v1/... URLs instead.
API__SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
API__SUPABASE_JWT_ISS=http://127.0.0.1:54321/auth/v1
API__SUPABASE_JWT_AUD=authenticated
API__JWKS_CACHE_TTL=900

# Admin bootstrap (see planning/api-contract.md#admin) — Supabase `sub` UUID
# of the first admin. Empty by default; set once, promote others via the UI.
API__ADMIN_UUID=

# CORS — comma-separated origin allow-list.
API__CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional overrides — uncomment to replace file-based Cache/Log/Mail
# defaults in api/config/app.php. Leave commented for local dev.
#API__CACHE_DEFAULT_URL=file:///path/to/tmp/cache/?prefix=ollert_default_&duration=+2 minutes
#API__CACHE_CAKECORE_URL=file:///path/to/tmp/cache/persistent?prefix=ollert_cake_translations_&serialize=true&duration=+1 years
#API__CACHE_CAKEMODEL_URL=file:///path/to/tmp/cache/models?prefix=ollert_cake_model_&serialize=true&duration=+1 years
#API__EMAIL_TRANSPORT_DEFAULT_URL=
#API__LOG_DEBUG_URL=file:///path/to/logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug
#API__LOG_ERROR_URL=file:///path/to/logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error

# ============================================================
# WEB  →  web/.env   (TanStack Start frontend, local dev)
# ============================================================
# supabase status reprints these if the project ever gets reinitialized.
WEB__VITE_SUPABASE_URL=http://127.0.0.1:54321
WEB__VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
WEB__VITE_API_BASE_URL=http://localhost:8765/api

# ── Prod build overrides → web/.env.production ─────────────────────────────
# `vite build` (mode=production) loads web/.env then web/.env.production (later
# overrides). Dev and prod use DIFFERENT Supabase projects (2026-08-29 migration:
# dev = local CLI stack above, prod = hosted), so all three VITE_ vars must be
# overridden here, not just the API URL. Fill in your hosted project ref + prod
# publishable key + prod API origin. Without these, the prod SPA bakes in the
# local stack → login hits localhost and forgot-password mail goes to Mailpit.
WEB_PROD__VITE_API_BASE_URL=https://<api-host>/api
WEB_PROD__VITE_SUPABASE_URL=https://<project-ref>.supabase.co
WEB_PROD__VITE_SUPABASE_PUBLISHABLE_KEY=<prod publishable key>

# ============================================================
# MCP  →  mcp/.env   (MCP server)
# ============================================================
# Deliberately stays pointed at the HOSTED Supabase project, not the local
# stack above — the claude.ai OAuth consent dance needs Supabase's hosted
# OAuth-AS feature + a registered redirect URI, neither set up locally.
# See mcp/.env.example for the full rationale. Fill in your project ref.
MCP__SUPABASE_URL=https://<project-ref>.supabase.co
MCP__SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
MCP__SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1
MCP__SUPABASE_JWT_AUD=authenticated
MCP__SUPABASE_AS_METADATA_URL=https://<project-ref>.supabase.co/.well-known/oauth-authorization-server/auth/v1
MCP__JWKS_CACHE_TTL=900
MCP__API_BASE_URL=http://localhost:8765
MCP__MCP_PUBLIC_BASE_URL=https://ollert-mcp.2719.fyi
MCP__PORT=8766

# ============================================================
# E2E  →  e2e/.env   (Playwright suite — optional for day-to-day dev)
# ============================================================
E2E__WEB_BASE_URL=http://localhost:3000
E2E__API_BASE_URL=http://localhost:8765/api
# Same Supabase project /web is configured against — local stack by default.
# Local Auth has enable_confirmations=false, so the email-rate-limit /
# Mailpit workarounds in e2e/README.md mostly apply only if you point this
# at the hosted project instead.
E2E__SUPABASE_URL=http://127.0.0.1:54321
E2E__SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Preferred auth strategy — service_role key, creates throwaway users per run.
# Local stack's is printed by `supabase status` (SERVICE_ROLE_KEY). NEVER
# ship this to the browser/frontend.
#E2E__SUPABASE_SERVICE_ROLE_KEY=
# Fallback — two already-confirmed accounts, only used if the above is unset.
#E2E__E2E_OWNER_EMAIL=
#E2E__E2E_OWNER_PASSWORD=
#E2E__E2E_MEMBER_EMAIL=
#E2E__E2E_MEMBER_PASSWORD=

# ============================================================
# KAMAL  →  .kamal/secrets   (PROD deploy secrets — not needed for local dev)
# ============================================================
# Only fill these out when actually deploying. See DEPLOYMENT.md.
# KAMAL__DATABASE_URL is also the single source of truth for the prod DB
# connection string: `bun run env` copies it into api/.env as
# DATABASE_URL_PROD, which `bun migrate:prod` uses to run phinx against hosted
# Supabase from a dev machine (see DEPLOYMENT.md §3).
KAMAL__DATABASE_URL=postgres://<user>:CHANGE_ME@<host>:<port>/<db>?ssl=true&ssl_mode=require
KAMAL__SECURITY_SALT=CHANGE_ME
KAMAL__SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
KAMAL__SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1
# mcp deploy (config/deploy.mcp.yml) also reads SUPABASE_URL +
# SUPABASE_AS_METADATA_URL from .kamal/secrets. Source them here under KAMAL__
# so `bun env --force` regenerates them; otherwise --force drops them (it
# rebuilds .kamal/secrets from KAMAL__* only) and the next mcp deploy fails.
# Same hosted project as the MCP__* values above.
KAMAL__SUPABASE_URL=https://<project-ref>.supabase.co
KAMAL__SUPABASE_AS_METADATA_URL=https://<project-ref>.supabase.co/.well-known/oauth-authorization-server/auth/v1
