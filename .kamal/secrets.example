# Copy to .kamal/secrets (repo root) and fill in real values.
# Read by kamal via the `secret:` name-lists in the deploy configs (kamal
# 2.12.0 has NO `secret()` ERB helper — don't write `<%= secret("X") %>`;
# it fails with `NoMethodError: undefined method 'secret'`). Gitignored
# (.gitignore has .kamal/secrets) — the .example is safe to commit, the
# real file is not.

# ── API app runtime (deploy.api.yml env:secret) ──────────────────────────
# Supabase-hosted Postgres connection string — Project Settings -> Database
# -> Connection string in the Supabase dashboard. See DEPLOYMENT.md's "API
# DB connection" section for pooled-vs-direct connection notes. No accessory
# involved (that MariaDB setup was removed 2026-08-29 — see post-merge.md).
DATABASE_URL=postgres://<user>:CHANGE_ME@<host>:<port>/<db>?sslmode=require
# Random 40+ char string — `php -r 'echo bin2hex(random_bytes(40));'`
SECURITY_SALT=CHANGE_ME
# Supabase JWKS + JWT issuer (project-ref baked into the URL).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1

# ── Web SPA build-time (NOT in .kamal/secrets) ───────────────────────────
# The web SPA is built LOCALLY (bun run build in web/, reading web/.env)
# before `kamal deploy`. VITE_ vars (VITE_API_BASE_URL, VITE_SUPABASE_URL,
# VITE_SUPABASE_PUBLISHABLE_KEY) live in web/.env (gitignored), not here —
# they're public (publishable key + URL ship in the client bundle) and the
# local build bakes them in. See web/.env.example and DEPLOYMENT.md.