# Vars docker-compose.yml expects dokploy to inject via its per-app
# Environment tab. Not read by anything directly (no code loads this file) —
# it's a reference for filling in dokploy's UI, one variable per line as
# KEY=value. Values marked (shared) are the same string across all three
# services; set them once per app in dokploy, no single source of truth
# script wires this yet (scripts/sync-env.sh only feeds kamal + local dev
# today — extending it to a dokploy prefix is later work).

## api

# The api service's own public URL, once dokploy assigns/routes one.
# Prevents Host Header Injection — must match exactly.
API_FULL_BASE_URL=
# The web service's public URL — CORS allow-list.
WEB_ORIGIN=
# Supabase hosted Postgres connection string. postgres://...?ssl=true&ssl_mode=require
# — NOT ?sslmode=require, CakePHP's DSN parser doesn't read that key.
DATABASE_URL=
# CakePHP's cookie/session/CSRF signing salt.
SECURITY_SALT=

## api + mcp (shared)

SUPABASE_JWKS_URL=
SUPABASE_JWT_ISS=

## mcp

# api's public URL, reachable from mcp at runtime (same value as
# API_FULL_BASE_URL above, unless the two are split across different
# domains).
API_PUBLIC_URL=
# mcp's own public URL — the resource identifier in its RFC 9728 metadata.
MCP_PUBLIC_URL=
SUPABASE_URL=
# .../.well-known/oauth-authorization-server/auth/v1
SUPABASE_AS_METADATA_URL=
