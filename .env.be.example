# Copy to .env.be (or /api/.env once /api is scaffolded — see planning/architecture.md)
# and fill in real values. Everything CakePHP's /api needs; see be-tasks.md.

# --- CakePHP core (config/app_local.php reads these) ---
APP_NAME=Ollert
DEBUG=true
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=en_US
APP_DEFAULT_TIMEZONE=UTC
# Random 40+ char string, unique per environment.
SECURITY_SALT=

# --- DB (docker/ MariaDB in local dev — must match docker/.env) ---
DB_HOST=127.0.0.1
DB_PORT=9937
DB_DATABASE=ollert
DB_USERNAME=ollert
DB_PASSWORD=change-me

# --- Supabase JWT verification (see planning/architecture.md#auth-flow) ---
# Project settings -> API -> JWT Keys once the Supabase project exists.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
JWKS_CACHE_TTL=900

# --- CORS (see planning/architecture.md#cors) ---
# Comma-separated origin allow-list.
CORS_ALLOWED_ORIGINS=http://localhost:5173
