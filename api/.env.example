# Copy to api/.env and fill in real values. Everything CakePHP's /api needs; see be-tasks.md.
# See CakePHPDivergance.md for why this lives at api/.env instead of api/config/.env.

# --- CakePHP core (config/app.php reads these) ---
APP_NAME=Ollert
DEBUG=true
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=en_US
APP_DEFAULT_TIMEZONE=UTC
# SECURITY: required in production to prevent Host Header Injection attacks.
APP_FULL_BASE_URL=
# Random 40+ char string, unique per environment.
SECURITY_SALT=

# --- DB (Supabase CLI local stack in local dev — `supabase start` from the repo root;
# see planning/supabase-migration.md#local-dev and README.md#local-development) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Used only by the PHPUnit test suite; defaults to a throwaway sqlite file if unset.
#DATABASE_TEST_URL=sqlite://127.0.0.1/tmp/tests.sqlite

# --- Supabase JWT verification (see planning/architecture.md#auth-flow) ---
# Local (Supabase CLI stack, RS256 via supabase/signing_keys.json — see CLAUDE.md
# Learnings 2026-08-27): both point at 127.0.0.1:54321, as below.
# Prod (hosted project, Project Settings -> API -> JWT Keys): both point at
# https://<project-ref>.supabase.co/auth/v1/...
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUD=authenticated
JWKS_CACHE_TTL=900

# --- Admin bootstrap (see planning/api-contract.md#admin) ---
# Supabase `sub` UUID of the first admin. Empty by default (no bootstrap
# admin) — set once, on that user's first request `is_admin` is set true
# during JIT provisioning; promote/demote others via the admin UI after.
ADMIN_UUID=

# --- CORS (see planning/architecture.md#cors) ---
# Comma-separated origin allow-list.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional overrides: uncomment to replace the file-based Cache/Log defaults ---
# or the Mail-function EmailTransport default in app.php with a DSN.
#CACHE_DEFAULT_URL=file:///path/to/tmp/cache/?prefix=ollert_default_&duration=+2 minutes
#CACHE_CAKECORE_URL=file:///path/to/tmp/cache/persistent?prefix=ollert_cake_translations_&serialize=true&duration=+1 years
#CACHE_CAKEMODEL_URL=file:///path/to/tmp/cache/models?prefix=ollert_cake_model_&serialize=true&duration=+1 years
#EMAIL_TRANSPORT_DEFAULT_URL=
#LOG_DEBUG_URL=file:///path/to/logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug
#LOG_ERROR_URL=file:///path/to/logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error
