# Copy to .env.deploy (repo root) and fill in real values.
# Read by both scripts/deploy-web.sh (/web) and scripts/deploy-api.sh (/api)
# — the local (non-CI) deploy scripts. Both deploy to the same shared PHP
# host, so the DEPLOY_HOST/DEPLOY_USER/DEPLOY_PORT/DEPLOY_SSH_KEY vars below
# are shared between them; each script also has its own destination-path
# var since /web and /api sync to different places on that host.
# See planning/architecture.md#deployment.

# --- Shared PHP host (SSH) ---
# Hostname or IP of the shared PHP host.
DEPLOY_HOST=
# SSH user on that host.
DEPLOY_USER=

# --- /web deploy (scripts/deploy-web.sh) ---
# Absolute (or account-relative) path on the host the SPA build should be
# synced into — typically the public_html/ dir (or a subdirectory of it) that
# the web/ domain or subdomain serves. The deploy script syncs with
# rsync --delete, so this path must be dedicated to the web app's static
# files only — anything else living under it (the API, uploads, other
# sites) will be deleted.
DEPLOY_PATH=

# --- /api deploy (scripts/deploy-api.sh) ---
# Absolute (or account-relative) path on the host the CakePHP app should be
# synced into. Also syncs with rsync --delete (vendor/, tmp/, logs/, and
# .env under this path are excluded from the sync and left alone — see the
# script for the full exclude list), so this path must be dedicated to the
# API only.
API_DEPLOY_PATH=
# Composer binary to invoke over SSH after the sync, if "composer" isn't on
# PATH in the remote shell (e.g. a host-specific wrapper script).
API_REMOTE_COMPOSER_BIN=composer

# --- Optional ---
# SSH port, if not the default.
DEPLOY_PORT=22
# Path to a private key to use for the SSH connection, if not ssh's default
# (~/.ssh/id_*) or an entry in ~/.ssh/config for DEPLOY_HOST.
DEPLOY_SSH_KEY=
