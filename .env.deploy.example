# Copy to .env.deploy (repo root) and fill in real values.
# Read by scripts/deploy-web.sh — the local (non-CI) /web deploy script.
# See planning/architecture.md#deployment.

# --- Shared PHP host (SSH) ---
# Hostname or IP of the shared PHP host.
DEPLOY_HOST=
# SSH user on that host.
DEPLOY_USER=
# Absolute (or account-relative) path on the host the SPA build should be
# synced into — typically the public_html/ dir (or a subdirectory of it) that
# the web/ domain or subdomain serves.
DEPLOY_PATH=

# --- Optional ---
# SSH port, if not the default.
DEPLOY_PORT=22
# Path to a private key to use for the SSH connection, if not ssh's default
# (~/.ssh/id_*) or an entry in ~/.ssh/config for DEPLOY_HOST.
DEPLOY_SSH_KEY=
