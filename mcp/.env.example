# Copy to mcp/.env and fill in real values. Mirrors api/.env's Supabase
# values exactly — no separate values invented. See planning/mcp-server.md.

# --- Supabase (shared with api/) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
# OAuth 2.1 authorization-server metadata (RFC 8414) — what mcp/ points
# claude.ai at via RFC 9728 protected-resource metadata. Supabase hosts this
# at .../.well-known/oauth-authorization-server/auth/v1.
SUPABASE_AS_METADATA_URL=https://<project-ref>.supabase.co/.well-known/oauth-authorization-server/auth/v1
JWKS_CACHE_TTL=900

# --- Targets ---
# CakePHP API base (no trailing slash). mcp/ forwards the caller's Bearer
# token here unchanged on every tool call.
API_BASE_URL=http://localhost:8765
# This server's own public URL (the Cloudflare Tunnel domain). Used as the
# `resource` parameter value / canonical URI claude.ai requests tokens for.
MCP_PUBLIC_BASE_URL=https://ollert-mcp.2719.fyi

# --- HTTP ---
PORT=8766