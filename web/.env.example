# Copy to .env in this directory and fill in real values.
# VITE_ prefix required — Vite only exposes prefixed vars to client code via
# import.meta.env. See the root .env.fe.example for provenance notes.

# Dev value: Supabase CLI local stack (`supabase start` from the repo root —
# see planning/supabase-migration.md#local-dev). `supabase status` reprints
# these after a stop/start cycle if the project ever gets reinitialized.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Base URL of the CakePHP API (see be-tasks.md). Dev value:
VITE_API_BASE_URL=http://localhost:8765/api

# ── Prod builds ───────────────────────────────────────────────────────────
# `vite build` runs in mode=production, which loads .env then .env.production
# (later overrides). Prod points at the real hosted Supabase project, not the
# local CLI stack above, so — unlike before the Supabase migration — Supabase
# URL/key now also need overriding, not just the API URL. Copy this block to
# web/.env.production (gitignored) for a prod build:
#   VITE_API_BASE_URL=https://ollert-api.2719.fyi/api
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=<prod publishable key>
