# Copy to .env in this directory and fill in real values.
# VITE_ prefix required — Vite only exposes prefixed vars to client code via
# import.meta.env. See the root .env.fe.example for provenance notes.

# Project settings -> API -> Project URL / publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the CakePHP API (see be-tasks.md). Dev value:
VITE_API_BASE_URL=http://localhost:8765/api

# ── Prod builds ───────────────────────────────────────────────────────────
# `vite build` runs in mode=production, which loads .env then .env.production
# (later overrides). So prod API URL lives in .env.production, not here.
# Copy this block to web/.env.production (gitignored) for a prod build:
#   VITE_API_BASE_URL=https://ollert-api.2719.fyi/api
# Supabase URL + publishable key are the same project dev+prod, so they stay
# in .env and carry through — .env.production only overrides the API URL.
